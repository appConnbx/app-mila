# ============================================================================
# appMila — TEMPLATE de variáveis (SÓ NOMES, SEM VALORES)
# Copie para .env.local (web) / .env (mobile) e preencha na CONTA NOVA.
# NUNCA versione o arquivo preenchido. NUNCA reutilize segredos do ambiente antigo.
# NEXT_PUBLIC_/EXPO_PUBLIC_ podem ir ao cliente; as demais são SECRETAS (servidor).
# ============================================================================

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRETA — só servidor/webhook

# --- Mobile (Expo) — apps/mobile/.env ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- App base / site ---
APP_BASE_URL=http://localhost:3000    # prod: https://www.<seu-dominio>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Claude API (NLP) ---
ANTHROPIC_API_KEY=                    # SECRETA

# --- Stripe (internacional) ---
STRIPE_SECRET_KEY=                    # SECRETA (sk_live)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=                # SECRETA (whsec_)

# --- Hotmart (BR + afiliados) ---
HOTMART_HOTTOK=                       # SECRETA — valida o webhook

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_VERIFY_TOKEN=                # você define
WHATSAPP_ACCESS_TOKEN=                # SECRETA
WHATSAPP_PHONE_NUMBER_ID=

# --- Analytics (opcional) ---
NEXT_PUBLIC_GA4_ID=

# ============================================================================
# NÃO vai no .env do app (configurar no painel do serviço):
#   RESEND_API_KEY            -> Supabase > Edge Function secrets (função send-email)
#   TAURI_SIGNING_PRIVATE_KEY -> GitHub Actions secret (release do agente Tauri)
# ============================================================================

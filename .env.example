# ============================================================================
# APP MILA — Exemplo de variáveis de ambiente
# Copie para .env.local (web) e .env (mobile) e preencha. NUNCA versione o .env.
# As chaves "públicas" (NEXT_PUBLIC_/EXPO_PUBLIC_) podem ir ao cliente.
# As demais são SECRETAS e só podem ser usadas no servidor/webhook.
# ============================================================================

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # SECRETA — só no servidor/webhook

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Claude API (interpretação de mensagens do WhatsApp) ---
ANTHROPIC_API_KEY=                    # SECRETA

# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_VERIFY_TOKEN=                # você define; usado na verificação do webhook
WHATSAPP_ACCESS_TOKEN=                # SECRETA
WHATSAPP_PHONE_NUMBER_ID=

# --- Hotmart (cobrança do SaaS via webhook/postback) ---
HOTMART_HOTTOK=                       # SECRETA — token p/ validar o webhook da Hotmart
APP_BASE_URL=http://localhost:3000    # base p/ links de convite enviados ao comprador

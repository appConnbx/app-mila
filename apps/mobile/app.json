{
  "expo": {
    "name": "appMila",
    "slug": "mila-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mila",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "primaryColor": "#22D3EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.appmila.mobile",
      "buildNumber": "1"
    },
    "android": {
      "package": "co.appmila.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "go.appmila.co"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "O appMila usa o microfone para criar demandas por voz."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Record",
              "label": "appMila — Gravar",
              "description": "Toque para criar uma demanda por voz",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "previewImage": "./assets/widget-preview.png"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "03157a7c-de64-4364-a48e-e198207e300f"
      }
    }
  }
}
